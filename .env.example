# Meta Pixel + Conversions API
# Pixel ID is public-safe (already in <noscript> img on the page).
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only — generate at Events Manager → Settings → Conversions API → Generate Access Token.
# Long-lived token expires ~60 days. Rotate via `vercel env add META_CAPI_ACCESS_TOKEN production`.
META_CAPI_ACCESS_TOKEN=
# Feature flag: 'false' disables all CAPI calls; default enabled when token present.
META_CAPI_ENABLED=
# Optional: test_event_code from Events Manager Test Events tool. Empty in production.
META_CAPI_TEST_EVENT_CODE=
